# Backend-only configuration. Do not put any real keys in this file.
CONTEXT_BRIDGE_API_TOKEN=replace_with_a_random_token_of_at_least_32_characters
CONTEXT_BRIDGE_PROVIDER_API_KEY=replace_me
# Google Gemini OpenAI-compatible base URL (the adapter appends chat/completions once).
CONTEXT_BRIDGE_PROVIDER_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
CONTEXT_BRIDGE_PROVIDER_MODEL=gemini-3.8-flash
CONTEXT_BRIDGE_PORT=8787
# This localhost-only build only accepts 127.0.0.1.
CONTEXT_BRIDGE_HOST=127.0.0.1
CONTEXT_BRIDGE_MAX_BODY_BYTES=256000
CONTEXT_BRIDGE_MAX_RESPONSE_BYTES=1000000
CONTEXT_BRIDGE_TIMEOUT_MS=30000
CONTEXT_BRIDGE_RATE_LIMIT=30
CONTEXT_BRIDGE_RATE_LIMIT_WINDOW_MS=60000
# Relative paths resolve from the process working directory.
CONTEXT_BRIDGE_RATE_LIMIT_DB_PATH=.context-bridge/api-rate-limit.sqlite
